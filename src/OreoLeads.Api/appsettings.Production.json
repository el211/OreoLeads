{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.AspNetCore": "Error",
        "Microsoft.EntityFrameworkCore": "Error",
        "System": "Error"
      }
    }
  },
  "Database": {
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false,
    "MaxRetryCount": 5
  },
  "RateLimit": {
    "PermitLimit": 200,
    "WindowSeconds": 60,
    "QueueLimit": 20
  },
  "Hsts": {
    "MaxAge": 365,
    "IncludeSubDomains": true,
    "Preload": true
  }
}
