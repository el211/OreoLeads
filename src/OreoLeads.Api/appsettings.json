{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=oreo_leads;Username=oreo;Password=oreo_password",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_IN_PRODUCTION_Min32Chars!!",
    "Issuer": "OreoLeads",
    "Audience": "OreoLeads",
    "ExpiryMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://localhost:3000"],
    "AllowCredentials": true
  },
  "AllowedHosts": "*",
  "Ai": {
    "EncryptionKey": "CHANGE_ME_IN_PRODUCTION_32chars!!"
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false,
    "MaxRetryCount": 3
  },
  "Redis": {
    "DefaultExpiryMinutes": 60,
    "Enabled": true
  },
  "Observability": {
    "ServiceName": "OreoLeads",
    "ServiceVersion": "1.0.0",
    "EnableTracing": true,
    "EnableMetrics": true
  },
  "RateLimit": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 10
  },
  "BraveSearch": {
    "ApiKey": "",
    "ResultsPerQuery": 10,
    "MinIntervalMs": 1100,
    "CacheHours": 168
  },
  "Enrichment": {
    "AutoEnrichOnImport": true,
    "AutoApplyThreshold": 0.8,
    "ReviewThreshold": 0.4,
    "MaxConcurrentJobs": 2,
    "MaxJobsPerTick": 5,
    "TickSeconds": 10,
    "MaxQueriesPerLead": 4
  },
  "Playwright": {
    "Enabled": false,
    "NavigationTimeoutSeconds": 20,
    "PostLoadDelayMs": 750,
    "MaxConcurrentPages": 3
  }
}
