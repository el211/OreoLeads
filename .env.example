# Database
DATABASE_URL=Host=postgres;Port=5432;Database=oreoleads;Username=oreoleads;Password=CHANGEME
POSTGRES_DB=oreoleads
POSTGRES_USER=oreoleads
POSTGRES_PASSWORD=CHANGEME_STRONG_PASSWORD

# JWT
JWT_SECRET=CHANGEME_AT_LEAST_64_CHARS_RANDOM_STRING_FOR_PRODUCTION
JWT_ISSUER=OreoLeads
JWT_AUDIENCE=OreoLeads

# Encryption
ENCRYPTION_KEY=CHANGEME_AT_LEAST_32_CHARS_RANDOM

# Brevo
BREVO_ENCRYPTION_KEY=CHANGEME_BREVO_ENCRYPTION_KEY

# Airtable
AIRTABLE_ENCRYPTION_KEY=CHANGEME_AIRTABLE_ENCRYPTION_KEY

# AI
AI_ENCRYPTION_KEY=CHANGEME_AI_ENCRYPTION_KEY

# Redis
REDIS_PASSWORD=CHANGEME_REDIS_PASSWORD

# MinIO
MINIO_ROOT_USER=oreoleads
MINIO_ROOT_PASSWORD=CHANGEME_MINIO_PASSWORD

# RabbitMQ
RABBITMQ_USER=oreoleads
RABBITMQ_PASSWORD=CHANGEME_RABBITMQ_PASSWORD

# Enrichissement (découverte site/e-mail)
# Clé gratuite : https://brave.com/search/api
BRAVE_SEARCH_API_KEY=
# Optionnels (valeurs par défaut dans docker-compose) :
# ENRICHMENT_AUTO=true
# ENRICHMENT_THRESHOLD=0.8
# PLAYWRIGHT_ENABLED=true

# CORS
CORS_ORIGIN_0=https://your-domain.com

# Observability (optional)
# OTLP_ENDPOINT=http://otel-collector:4317
